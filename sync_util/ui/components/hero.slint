import { Theme } from "../theme.slint";
import { ToolButton } from "buttons.slint";

// Banner a gradiente: logo, titolo e cambio tema, con due cerchi decorativi in trasparenza.
export component Hero inherits Rectangle {
    callback toggle-theme;

    border-radius: 18px;
    background: @linear-gradient(105deg, Theme.hero-start 0%, Theme.hero-middle 65%, Theme.hero-end 100%);
    drop-shadow-color: Theme.hero-middle.with-alpha(Theme.dark ? 0.4 : 0.25);
    drop-shadow-blur: 22px;
    drop-shadow-offset-y: 6px;
    clip: true;

    Rectangle {
        x: parent.width - 260px;
        y: -120px;
        width: 260px;
        height: 260px;
        border-radius: 130px;
        background: #ffffff12;
    }

    Rectangle {
        x: parent.width - 120px;
        y: parent.height - 50px;
        width: 160px;
        height: 160px;
        border-radius: 80px;
        background: #ffffff0d;
    }

    HorizontalLayout {
        padding-left: 22px;
        padding-right: 16px;
        padding-top: 18px;
        padding-bottom: 18px;
        spacing: 16px;
        Image {
            source: @image-url("../icons/logo.svg");
            width: 56px;
            height: 56px;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: "Dimensions Sync";
                font-size: 26px;
                font-weight: 700;
                color: #ffffff;
            }
            Text {
                text: "Allinea la cartella di destinazione al contenuto della sorgente";
                font-size: 15px;
                color: #ffffffd9;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            ToolButton {
                icon: Theme.dark ? @image-url("../icons/sun.svg") : @image-url("../icons/moon.svg");
                tooltip: Theme.dark ? "Passa al tema chiaro" : "Passa al tema scuro";
                icon-size: 20px;
                tint: #ffffff;
                hover-color: #ffffff2e;
                pressed-color: #ffffff4d;
                min-height: 40px;
                clicked => {
                    root.toggle-theme();
                }
            }
        }
    }
}
