import { Theme } from "../theme.slint";
import { ToolButton } from "buttons.slint";

// Campo di ricerca con icona, testo segnaposto e pulsante per svuotarlo.
// Il bordo si colora quando ha il focus.
export component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback edited(string);
    callback accepted();

    forward-focus: input;
    min-height: 36px;
    border-radius: 10px;
    background: Theme.well;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : touch.has-hover ? Theme.dash : Theme.card-border;
    animate border-color { duration: Theme.fast; }

    touch := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => {
            input.focus();
        }
    }

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 4px;
        spacing: 8px;
        Image {
            source: @image-url("../icons/search.svg");
            colorize: input.has-focus ? Theme.accent : Theme.muted;
            width: 15px;
            image-fit: contain;
        }
        Rectangle {
            horizontal-stretch: 1;
            clip: true;
            input := TextInput {
                width: 100%;
                height: 100%;
                text <=> root.text;
                color: Theme.foreground;
                selection-background-color: Theme.accent.with-alpha(0.35);
                selection-foreground-color: Theme.foreground;
                vertical-alignment: center;
                single-line: true;
                edited => {
                    root.edited(self.text);
                }
                accepted => {
                    root.accepted();
                }
            }
            if root.text == "": Text {
                x: 0;
                width: parent.width;
                text: root.placeholder;
                color: Theme.muted;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if root.text != "": VerticalLayout {
            alignment: center;
            ToolButton {
                icon: @image-url("../icons/x.svg");
                icon-size: 13px;
                min-height: 26px;
                tint: Theme.muted;
                tooltip: "Annulla la ricerca";
                clicked => {
                    root.text = "";
                    root.edited("");
                    input.focus();
                }
            }
        }
    }
}
